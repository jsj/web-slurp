#!/bin/sh
set -eu
cd -- "$(dirname -- "$0")"
slurp_root=$(pwd -P)
slurp_install=${WEB_SLURP_INSTALL_DIR:-"$HOME/.web-slurp"}
mkdir -p "$slurp_install"
slurp_install=$(cd "$slurp_install" && pwd -P)
if [ "$slurp_root" != "$slurp_install" ]; then
  # Copy the package, including Git metadata for updates, but recreate runtimes
  # at their final location (Python virtual environments are not relocatable).
  tar --exclude='./node_modules' --exclude='./.venv' --exclude='./.runtime' \
    --exclude='./targets' --exclude='./.DS_Store' -cf - . | tar -xf - -C "$slurp_install"
  cd "$slurp_install"
  exec ./setup "$@"
fi
export PATH="$slurp_root/.runtime/bun/bin:$PATH"

if [ ! -x .runtime/bun/bin/bun ]; then
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) slurp_platform=darwin-aarch64 ;;
    Darwin-x86_64) slurp_platform=darwin-x64 ;;
    Linux-aarch64|Linux-arm64) slurp_platform=linux-aarch64 ;;
    Linux-x86_64) slurp_platform=linux-x64 ;;
    *) echo 'Automatic setup supports macOS and Linux on Intel or ARM64.' >&2; exit 1 ;;
  esac
  mkdir -p .runtime/bun/bin
  slurp_download=$(mktemp -d)
  trap 'rm -rf "$slurp_download"' EXIT HUP INT TERM
  echo 'Installing the web-slurp runtime…'
  curl -fL --retry 3 "https://github.com/oven-sh/bun/releases/download/bun-v1.4.2/bun-$slurp_platform.zip" -o "$slurp_download/bun.zip"
  unzip -q "$slurp_download/bun.zip" -d "$slurp_download"
  mv "$slurp_download/bun-$slurp_platform/bun" .runtime/bun/bin/bun
  rm -rf "$slurp_download"
  trap - EXIT HUP INT TERM
fi

if [ ! -x .venv/bin/python3 ]; then
  mkdir -p .runtime/uv
  if [ ! -x .runtime/uv/uv ]; then
    curl -fsSL --retry 3 https://astral.sh/uv/0.8.22/install.sh -o .runtime/uv/install.sh
    UV_UNMANAGED_INSTALL="$slurp_root/.runtime/uv" sh .runtime/uv/install.sh
  fi
  UV_PYTHON_INSTALL_DIR="$slurp_root/.runtime/python" .runtime/uv/uv venv --managed-python --python 3.12 --seed .venv
fi

[ -f bun.lock ] || cp dependencies.lock bun.lock
bun install --frozen-lockfile
bun update agent-browser --no-save
exec bun run src/cli.ts setup "$@"
