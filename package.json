    ".README",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsj/web-slurp.git"
  },
